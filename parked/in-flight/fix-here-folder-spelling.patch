+    ui.click("search");
+    ui.type_text("atlas");
+    let names = ui.names();
+    assert!(names.iter().any(|n| n == "Project Atlas.txt"), "{names:?}");
+    ui.click("by-contents");
+    assert_eq!(ui.names(), ["Project Atlas.txt"], "the file with the word");
+
+    ui.press(&cmd("f"));
+    ui.type_text("budget");
+    ui.click("by-name");
+    assert!(ui.names().is_empty(), "Budget.csv is outside Projects");
+}
